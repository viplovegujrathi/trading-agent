[Unit]
Description=Iron condor agent: read-only dashboard (loopback or Tailscale address only)
After=network-online.target tailscaled.service

[Service]
User=tagent
WorkingDirectory=/opt/trading-agent/app
EnvironmentFile=/opt/trading-agent/app/.env
ExecStart=/opt/trading-agent/app/.venv/bin/python -m trading_agent.cli dashboard --host ${DASH_HOST} --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/trading-agent/app

[Install]
WantedBy=multi-user.target
