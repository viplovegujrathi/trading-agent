# paper (offline simulator) | sandbox | production
TT_ENV=sandbox
# env (read TT_* below) | ssm (read /trading-agent/<env>/* from Parameter Store; recommended on EC2)
TA_SECRETS=env
TT_CLIENT_ID=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
TT_ACCOUNT=
# cli (approve with `cli submit <ext> --confirm "YES <ext>"`) | telegram
TA_APPROVAL_CHANNEL=cli
TA_TELEGRAM_BOT_TOKEN=
TA_TELEGRAM_CHAT_ID=
TA_TELEGRAM_USER_ID=
TA_HALT=0
# Ops (EC2 only)
AWS_REGION=
TA_BACKUP_BUCKET=
# cloudwatch to publish heartbeat/error metrics
TA_METRICS=
